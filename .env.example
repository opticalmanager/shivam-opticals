# ==============================================================================
# Shivam Optics - Environment Variables Template (.env.example)
# Copy this file to .env.local and populate with your production or test keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase / PostgreSQL Database & Auth Configuration
# ------------------------------------------------------------------------------
# Supabase Project API URL & Public Anon Key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Direct PostgreSQL Database Connection String (Transaction Pooler or Direct Port 5432)
# Supported by Neon, Supabase, AWS RDS, or local PostgreSQL
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres"
DATABASE_PASSWORD="your_password"

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (High-Speed Eyewear Media & 3D Assets CDN)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="shivam-optics-catalog"
R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"
R2_TOKEN_VALUE="your_optional_r2_api_token"

# Public CDN Base URL for catalog images & 3D GLB models
# (Cloudflare R2 Custom Domain or *.r2.dev public bucket URL)
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev"

# Base Application URL
NEXT_PUBLIC_APP_URL="https://www.shivamoptical.in"
NEXT_PUBLIC_SITE_URL="https://www.shivamoptical.in"
NEXT_PUBLIC_SHIPROCKET_WEBHOOK_URL="https://www.shivamoptical.in/api/webhooks/delivery"

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Mode: 'test' or 'live'
RAZORPAY_MODE="test"

# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Razorpay Webhook Secret (for verifying asynchronous settlement callbacks)
RAZORPAY_WEBHOOK_SECRET="shivam_optics_webhook_secret_2026"
